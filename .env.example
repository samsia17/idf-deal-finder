# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Utilisé côté serveur uniquement (fonctions Supabase Edge) — ne jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY=

# Identifiant Supabase Auth (uuid) du propriétaire des annonces/RDV, utilisé
# par les scripts d'ingestion tournant avec la clé de service (pas de session
# utilisateur donc pas d'auth.uid()). Trouvable dans Supabase Dashboard →
# Authentication → Users, après avoir créé ton compte.
APP_OWNER_USER_ID=

# Agent de contact — utilisés par les Supabase Edge Functions
# (supabase/functions/send-outreach-email, auto-outreach). À définir avec
# `supabase secrets set`, PAS dans ce fichier .env côté client.
# RESEND_API_KEY=...            (https://resend.com)
# OUTREACH_FROM_EMAIL="Prénom Nom <contact@votredomaine.fr>"
# OUTREACH_SENDER_NAME="Prénom Nom"
# OUTREACH_SENDER_PHONE=
# AUTO_OUTREACH_MIN_SCORE=70

# Mêmes infos, côté client cette fois, pour pré-remplir le brouillon affiché
# dans l'interface avant envoi (aucune donnée sensible ici).
VITE_OUTREACH_SENDER_NAME="Prénom Nom"
VITE_OUTREACH_SENDER_PHONE=

# data.gouv.fr DVF n'exige pas de clé API (open data public)

# Jinka (source d'annonces) — ⚠️ intégration NON OFFICIELLE contre l'API
# interne de leur appli (voir src/scrapers/adapters/jinkaAdapter.ts pour les
# détails et les risques : probable violation des CGU Jinka, risque de
# suspension de compte, peut casser sans préavis). Utilise un compte Jinka
# dédié plutôt que ton compte principal si possible. À définir avec
# `supabase secrets set` pour le déploiement, jamais commité.
# JINKA_EMAIL=
# JINKA_PASSWORD=
