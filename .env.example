# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Utilisé côté serveur uniquement (fonctions Supabase Edge) — ne jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY=

# Identifiant Supabase Auth (uuid) du propriétaire des annonces/RDV, utilisé
# par les scripts d'ingestion tournant avec la clé de service (pas de session
# utilisateur donc pas d'auth.uid()). Trouvable dans Supabase Dashboard →
# Authentication → Users, après avoir créé ton compte.
APP_OWNER_USER_ID=

# Agent de contact — utilisés par les Supabase Edge Functions
# (supabase/functions/send-outreach-email, auto-outreach). À définir avec
# `supabase secrets set`, PAS dans ce fichier .env côté client.
# RESEND_API_KEY=...            (https://resend.com)
# OUTREACH_FROM_EMAIL="Prénom Nom <contact@votredomaine.fr>"
# OUTREACH_SENDER_NAME="Prénom Nom"
# OUTREACH_SENDER_PHONE=
# AUTO_OUTREACH_MIN_SCORE=70

# Mêmes infos, côté client cette fois, pour pré-remplir le brouillon affiché
# dans l'interface avant envoi (aucune donnée sensible ici).
VITE_OUTREACH_SENDER_NAME="Prénom Nom"
VITE_OUTREACH_SENDER_PHONE=

# data.gouv.fr DVF n'exige pas de clé API (open data public)

# Jinka (source d'annonces) — deux méthodes possibles, JINKA_IMAP_* est
# prioritaire si les deux sont définies.
#
# Méthode 1 (compte avec connexion par code email, sans mot de passe fixe) :
# lecture des emails d'alerte Jinka en IMAP lecture seule. Utilise un
# mot de passe d'application (PAS ton mot de passe Apple ID principal) —
# génère-le sur https://appleid.apple.com → Sécurité → Mots de passe
# spécifiques à une app. Voir src/scrapers/adapters/jinkaEmailAdapter.ts —
# le parsing des emails n'est pas encore implémenté (besoin d'un exemple réel).
# JINKA_IMAP_HOST=imap.mail.me.com
# JINKA_IMAP_PORT=993
# JINKA_IMAP_USER=
# JINKA_IMAP_APP_PASSWORD=
#
# Méthode 2 (compte avec email + mot de passe classique) : ⚠️ intégration
# NON OFFICIELLE contre l'API interne de l'appli Jinka (voir
# src/scrapers/adapters/jinkaAdapter.ts pour les risques : probable violation
# des CGU, risque de suspension de compte, peut casser sans préavis).
# JINKA_EMAIL=
# JINKA_PASSWORD=
#
# À définir avec `supabase secrets set` pour le déploiement, jamais commité.
